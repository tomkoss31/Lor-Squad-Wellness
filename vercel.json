{
  "headers": [
    {
      "source": "/(marketing-plan|marketing-plan-prospect|marketing-plan-slides|opportunite-claude|copilote-v6-preview|copilote-v7-preview|pwa-client-preview|pwa-client-sanctuary-preview).html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(mockups|demo)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?labase-nutrition\\.com"
        }
      ],
      "destination": "https://www.labase360.fr/$1",
      "permanent": true
    },
    {
      "source": "/opportunite",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/simulateur",
      "destination": "/business#simulateur",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/coach/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|Pinterest|redditbot|Googlebot|bingbot|Embedly|vkShare|Applebot|SkypeUriPreview|Iframely|Google-InspectionTool).*"
        }
      ],
      "destination": "/api/coach-meta?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
